<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PlatformTarget>x64</PlatformTarget>
    <VlcWindowsX64Enabled>true</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
    <AssemblyName>CliveMediaCenter</AssemblyName>
    <Product>High Seas Media</Product>
    <AssemblyTitle>High Seas Media</AssemblyTitle>
    <Description>Your personal movie and television treasure chest</Description>
    <Version>1.0.0</Version>
    <ApplicationIcon>high-seas-taskbar.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AudioSwitcher.AudioApi.CoreAudio" Version="3.0.3" />
    <PackageReference Include="LibVLCSharp.WinForms" Version="3.10.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
    <None Include="..\..\play-movie.ps1" Link="play-movie.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\organize-media.ps1" Link="organize-media.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\media-library.json" Link="media-library.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\phone-app\High-Seas-Remote-latest.apk" Link="High-Seas-Remote-latest.apk" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\phone-app\High-Seas-Remote-version.txt" Link="High-Seas-Remote-version.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="high-seas-taskbar.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tools\**\*" Link="tools\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
